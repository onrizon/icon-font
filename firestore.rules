rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared team workspace: any verified @onrizon.com.br account has full
    // read/write access to all projects and icons.
    // NOTE: the domain is duplicated in src/lib/auth-domain.ts (rules cannot
    // import app code) — keep the two in sync.
    // A token with no email claim errors the condition, which denies (fail-closed).
    function isOnrizonUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@onrizon\\.com\\.br');
    }

    // Projects — team-shared. NOTE: collection is `project` (singular).
    match /project/{projectId} {
      allow read, delete: if isOnrizonUser();
      allow create: if isOnrizonUser()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOnrizonUser()
                    && request.resource.data.ownerUid == resource.data.ownerUid; // attribution is immutable
    }

    // Icons — team-shared; `parent` (the owning project id) cannot be changed.
    // The old ownsProject() get() lookup is gone: it no longer differentiates
    // users in a shared workspace and cost one billed read per icon op.
    match /icons/{iconId} {
      allow read, delete: if isOnrizonUser();
      allow create: if isOnrizonUser() && request.resource.data.parent is string;
      allow update: if isOnrizonUser()
                    && request.resource.data.parent == resource.data.parent; // cannot move between projects
    }
  }
}
